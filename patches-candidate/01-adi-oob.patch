From 3254dabb242286693bbcba80a72e1bd3b546940b Mon Sep 17 00:00:00 2001
From: Aibing Chen <chenaibing@cmss.chinamobile.com>
Date: Thu, 26 Nov 2026 15:54:25 +0800
Subject: [PATCH] Input: adi - reject ids with axis or button counts beyond the
 tables

adi_id_decode() takes the axis, hat and button counts from the device ID
packet and only checks them against the packet length.  adi_decode() and
adi_init_input() then walk the per-device tables in adi_abs[] and
adi_key[] with those counts, and the tables are much smaller: at most 9
axes and 11 buttons, while the packet can describe up to 49 axes and 126
buttons.

A device that reports such counts, accidentally or not, makes the driver
read past the end of the tables, both for the axis and button indices and
for the values passed to input_report_abs() and input_report_key().

Reject the id by clearing adi->length when the counts do not fit the
tables of the reported id, which is what the packet length check above
already does for bad packets.

Found by reviewing the counts that adi_id_decode() accepts.

Fixes: 1da177e4c3f4 ("Linux-2.6.12-rc2")
Cc: stable@vger.kernel.org
Link: https://sashiko.dev/#/bug/linux-92046c21-e0a8-4274-a502-20ca723131b1
Signed-off-by: Aibing Chen <chenaibing@cmss.chinamobile.com>
---
 drivers/input/joystick/adi.c | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/drivers/input/joystick/adi.c b/drivers/input/joystick/adi.c
index e07b71978..b01b4d0e4 100644
--- a/drivers/input/joystick/adi.c
+++ b/drivers/input/joystick/adi.c
@@ -73,6 +73,23 @@ static char* adi_abs[] = { adi_wmi_abs, adi_wmgpe_abs, adi_wmf_abs, adi_cm2_abs,
 static short* adi_key[] = { adi_wmi_key, adi_wmgpe_key, adi_cm2_key, adi_cm2_key, adi_wmi_key, adi_cm2_key,
 			    adi_wmgpe_key, adi_wmed3d_key, adi_wmgpe_key, adi_wmgpe_key, adi_wmi_key };
 
+/*
+ * Sizes of the tables in adi_abs[] and adi_key[], in the same order.
+ */
+static const unsigned char adi_abs_size[] = {
+	ARRAY_SIZE(adi_wmi_abs), ARRAY_SIZE(adi_wmgpe_abs), ARRAY_SIZE(adi_wmf_abs),
+	ARRAY_SIZE(adi_cm2_abs), ARRAY_SIZE(adi_wmi_abs), ARRAY_SIZE(adi_wmf_abs),
+	ARRAY_SIZE(adi_wmgpe_abs), ARRAY_SIZE(adi_wmed3d_abs), ARRAY_SIZE(adi_wmgpe_abs),
+	ARRAY_SIZE(adi_wmgpe_abs), ARRAY_SIZE(adi_wmi_abs)
+};
+
+static const unsigned char adi_key_size[] = {
+	ARRAY_SIZE(adi_wmi_key), ARRAY_SIZE(adi_wmgpe_key), ARRAY_SIZE(adi_cm2_key),
+	ARRAY_SIZE(adi_cm2_key), ARRAY_SIZE(adi_wmi_key), ARRAY_SIZE(adi_cm2_key),
+	ARRAY_SIZE(adi_wmgpe_key), ARRAY_SIZE(adi_wmed3d_key), ARRAY_SIZE(adi_wmgpe_key),
+	ARRAY_SIZE(adi_wmgpe_key), ARRAY_SIZE(adi_wmi_key)
+};
+
 /*
  * Hat to axis conversion arrays.
  */
@@ -377,6 +394,20 @@ static void adi_id_decode(struct adi *adi, struct adi_port *port)
 			adi->pad = -1;
 			break;
 	}
+	/*
+	 * The axis, hat and button counts come from the device and are only
+	 * limited by the packet length check above, while the tables in
+	 * adi_abs[] and adi_key[] are much smaller.  Reject ids whose counts
+	 * would make adi_decode() and adi_init_input() walk past the end of
+	 * the per-device tables.
+	 */
+	t = adi->id < ADI_ID_MAX ? adi->id : ADI_ID_MAX;
+	if (adi->axes10 + adi->axes8 + (adi->hats + (adi->pad != -1)) * 2 >
+			  adi_abs_size[t] ||
+	    adi->buttons > adi_key_size[t]) {
+		pr_warn("adi: Too many axes or buttons.\n");
+		adi->length = 0;
+	}
 }
 
 static int adi_init_input(struct adi *adi, struct adi_port *port, int half)
