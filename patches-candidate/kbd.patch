From e865cdecfa5d735757181b834bdbd361eca9d8ee Mon Sep 17 00:00:00 2001
From: Aibing Chen <chenaibing@cmss.chinamobile.com>
Date: Fri, 27 Nov 2026 11:54:59 +0800
Subject: [PATCH] Input: keyboard: use scnprintf() for the device physical
 paths

The keyboard drivers compose the physical path of their input devices as
"%s/input0" from serio->phys, which is a 32 byte string, into buffers of
the same size.  The composed string can reach 39 bytes, so it does not
fit: the path is informational and truncating it is acceptable, but the
call sites do not say so.

Because -Wformat-truncation is enabled for W=1 builds and COMPILE_TEST
configurations turn the warning into an error through CONFIG_WERROR,
these files do not build today, for example:

  drivers/input/keyboard/xtkbd.c:80:55: error: '/input0' directive output
    may be truncated writing 7 bytes into a region of size between 1 and
    32 [-Werror=format-truncation=]

Use scnprintf(), the helper that expresses a bounded, truncation tolerant
write, so that the files build warning free and the intent is visible at
the call sites.

No functional change.

Signed-off-by: Aibing Chen <chenaibing@cmss.chinamobile.com>
---
 drivers/input/keyboard/lkkbd.c     | 2 +-
 drivers/input/keyboard/newtonkbd.c | 2 +-
 drivers/input/keyboard/stowaway.c  | 2 +-
 drivers/input/keyboard/sunkbd.c    | 2 +-
 drivers/input/keyboard/xtkbd.c     | 2 +-
 5 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/drivers/input/keyboard/lkkbd.c b/drivers/input/keyboard/lkkbd.c
index f5c2267a2..5a7141719 100644
--- a/drivers/input/keyboard/lkkbd.c
+++ b/drivers/input/keyboard/lkkbd.c
@@ -624,7 +624,7 @@ static int lkkbd_connect(struct serio *serio, struct serio_driver *drv)
 	memcpy(lk->keycode, lkkbd_keycode, sizeof(lk->keycode));
 
 	strscpy(lk->name, "DEC LK keyboard", sizeof(lk->name));
-	snprintf(lk->phys, sizeof(lk->phys), "%s/input0", serio->phys);
+	scnprintf(lk->phys, sizeof(lk->phys), "%s/input0", serio->phys);
 
 	input_dev->name = lk->name;
 	input_dev->phys = lk->phys;
diff --git a/drivers/input/keyboard/newtonkbd.c b/drivers/input/keyboard/newtonkbd.c
index e60d1181d..675d744a9 100644
--- a/drivers/input/keyboard/newtonkbd.c
+++ b/drivers/input/keyboard/newtonkbd.c
@@ -75,7 +75,7 @@ static int nkbd_connect(struct serio *serio, struct serio_driver *drv)
 
 	nkbd->serio = serio;
 	nkbd->dev = input_dev;
-	snprintf(nkbd->phys, sizeof(nkbd->phys), "%s/input0", serio->phys);
+	scnprintf(nkbd->phys, sizeof(nkbd->phys), "%s/input0", serio->phys);
 	memcpy(nkbd->keycode, nkbd_keycode, sizeof(nkbd->keycode));
 
 	input_dev->name = "Newton Keyboard";
diff --git a/drivers/input/keyboard/stowaway.c b/drivers/input/keyboard/stowaway.c
index eade05542..a33166241 100644
--- a/drivers/input/keyboard/stowaway.c
+++ b/drivers/input/keyboard/stowaway.c
@@ -79,7 +79,7 @@ static int skbd_connect(struct serio *serio, struct serio_driver *drv)
 
 	skbd->serio = serio;
 	skbd->dev = input_dev;
-	snprintf(skbd->phys, sizeof(skbd->phys), "%s/input0", serio->phys);
+	scnprintf(skbd->phys, sizeof(skbd->phys), "%s/input0", serio->phys);
 	memcpy(skbd->keycode, skbd_keycode, sizeof(skbd->keycode));
 
 	input_dev->name = "Stowaway Keyboard";
diff --git a/drivers/input/keyboard/sunkbd.c b/drivers/input/keyboard/sunkbd.c
index 5a0020827..0c0179a1c 100644
--- a/drivers/input/keyboard/sunkbd.c
+++ b/drivers/input/keyboard/sunkbd.c
@@ -271,7 +271,7 @@ static int sunkbd_connect(struct serio *serio, struct serio_driver *drv)
 	sunkbd->dev = input_dev;
 	init_waitqueue_head(&sunkbd->wait);
 	INIT_WORK(&sunkbd->tq, sunkbd_reinit);
-	snprintf(sunkbd->phys, sizeof(sunkbd->phys), "%s/input0", serio->phys);
+	scnprintf(sunkbd->phys, sizeof(sunkbd->phys), "%s/input0", serio->phys);
 
 	serio_set_drvdata(serio, sunkbd);
 
diff --git a/drivers/input/keyboard/xtkbd.c b/drivers/input/keyboard/xtkbd.c
index c0b4978a8..256a2b703 100644
--- a/drivers/input/keyboard/xtkbd.c
+++ b/drivers/input/keyboard/xtkbd.c
@@ -77,7 +77,7 @@ static int xtkbd_connect(struct serio *serio, struct serio_driver *drv)
 
 	xtkbd->serio = serio;
 	xtkbd->dev = input_dev;
-	snprintf(xtkbd->phys, sizeof(xtkbd->phys), "%s/input0", serio->phys);
+	scnprintf(xtkbd->phys, sizeof(xtkbd->phys), "%s/input0", serio->phys);
 	memcpy(xtkbd->keycode, xtkbd_keycode, sizeof(xtkbd->keycode));
 
 	input_dev->name = "XT Keyboard";
